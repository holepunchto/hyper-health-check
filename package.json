{
  "name": "hyper-health-check",
  "version": "1.3.2",
  "description": "Health checks for hypercores, including prometheus support",
  "main": "index.js",
  "bin": {
    "hyper-health-check": "bin.js",
    "hyper-health-check-bare": "bin-bare.js"
  },
  "scripts": {
    "test": "prettier --check .",
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/hyper-health-check.git"
  },
  "files": [
    "bin.js",
    "bin-bare.js",
    "index.js",
    "lib/"
  ],
  "keywords": [
    "hypercore",
    "prometheus",
    "health",
    "check"
  ],
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hyper-health-check/issues"
  },
  "homepage": "https://github.com/holepunchto/hyper-health-check#readme",
  "devDependencies": {
    "lunte": "^1.8.6",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "dependencies": {
    "bare-http1": "^4.6.3",
    "bare-os": "^3.9.4",
    "bare-path": "^3.1.3",
    "bare-prom-client": "^15.1.10",
    "corestore": "^7.4.7",
    "graceful-goodbye": "^1.3.3",
    "hyper-instrument": "^3.3.1",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdrive": "^13.0.1",
    "hyperswarm": "^4.14.0",
    "listen-async": "^1.0.0",
    "paparam": "^1.8.6",
    "pino": "^9.12.0",
    "pino-bare": "^0.2.0",
    "ready-resource": "^1.2.0"
  },
  "imports": {
    "http": {
      "bare": "bare-http1",
      "default": "http"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "pino": {
      "bare": "pino-bare",
      "default": "pino"
    }
  }
}
